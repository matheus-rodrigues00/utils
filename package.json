{
  "name": "@teteu/utils",
  "version": "0.9.0",
  "description": "Zero-dependency library of commonly used cross-project utility methods",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "bun .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "production-test": "bun test",
    "typecheck": "tsc --noEmit",
    "compile-files": "tsc -p tsconfig.build.json",
    "lint": "biome check --write",
    "check": "biome check",
    "format": "biome format --write",
    "prepare": "bun run compile-files",
    "prepublishOnly": "bun run production-test && bun run compile-files"
  },
  "keywords": [
    "utils",
    "utilities"
  ],
  "files": [
    "dist",
    "helpers",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.4"
  }
}
